{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "mcp__aws-knowledge__*",
      "Bash(node check.js)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-cards.js\""
          }
        ]
      }
    ]
  }
}
